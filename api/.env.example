# Firebase Admin SDK
FIREBASE_PROJECT_ID=bilimal-org
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bilimal-org.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://bilimal-org-default-rtdb.europe-west1.firebasedatabase.app

# Public URL of this backend (Vercel)
PUBLIC_API_URL=https://YOUR-BILIMAL-API.vercel.app

# Public URL of the existing Bilimal storefront
PUBLIC_SITE_URL=https://bilimal.org

# FreedomPay Kyrgyzstan
FREEDOMPAY_BASE_URL=https://api.freedompay.kg
FREEDOMPAY_MERCHANT_ID=YOUR_MERCHANT_ID
FREEDOMPAY_SECRET_RECEIVE=YOUR_RECEIVE_SECRET
FREEDOMPAY_SECRET_PAYOUT=YOUR_PAYOUT_SECRET
FREEDOMPAY_TESTING_MODE=1

# Required public callbacks
FREEDOMPAY_RESULT_PATH=/api/webhooks/freedompay/result
FREEDOMPAY_CARD_POST_PATH=/api/webhooks/freedompay/card
FREEDOMPAY_PAYOUT_POST_PATH=/api/webhooks/freedompay/payout
