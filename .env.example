# Firebase Admin SDK (Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=bilimal-org
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bilimal-org.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_REAL_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://bilimal-org-default-rtdb.europe-west1.firebasedatabase.app
# Firebase Console > Storage > bucket name (e.g. bilimal-org.firebasestorage.app or bilimal-org.appspot.com)
FIREBASE_STORAGE_BUCKET=bilimal-org.firebasestorage.app

# Public website
PUBLIC_SITE_URL=https://bilimal.org

# Bilimal's own payment methods (QR image files are in the repository root)
SITE_MBANK_QR=/qrmbank.png
SITE_OBANK_QR=/%D0%9E!bank_QR.png
SITE_OBALANCE=0706035765

# Optional Gemini OCR. If empty, administrator reviews the receipt manually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
